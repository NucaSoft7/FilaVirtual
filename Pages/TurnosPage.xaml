<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="FilaVirtual.Pages.TurnosPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Mis turnos"
    BackgroundColor="#F5F7FC">

    <Grid RowDefinitions="Auto,*,Auto,70">

        <!-- ========================= -->
        <!-- ENCABEZADO -->
        <!-- ========================= -->

        <Grid
            Grid.Row="0"
            Padding="20,25,20,8"
            ColumnDefinitions="*,Auto">

            <VerticalStackLayout
                Grid.Column="0"
                Spacing="2">

                <Label
                    Text="Mis turnos"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="#101828"/>

                <Label
                    Text="Consulta tus turnos recientes"
                    FontSize="13"
                    TextColor="#667085"/>

            </VerticalStackLayout>


            <!-- ICONO FILTROS -->
            <Border
                Grid.Column="1"
                WidthRequest="42"
                HeightRequest="42"
                StrokeThickness="0"
                BackgroundColor="Transparent"
                VerticalOptions="Center">

                <Label
                    Text="☷"
                    FontSize="23"
                    TextColor="#344054"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>

            </Border>

        </Grid>


        <!-- ========================= -->
        <!-- LISTADO DE TURNOS -->
        <!-- ========================= -->

        <ScrollView Grid.Row="1">

            <VerticalStackLayout
                Padding="20,5,20,12"
                Spacing="10">


                <!-- ========================= -->
                <!-- TURNO A-025 -->
                <!-- ========================= -->

                <Border
                    BackgroundColor="White"
                    Stroke="#E9EDF4"
                    StrokeThickness="1"
                    Padding="14,11">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>

                    <Grid
                        ColumnDefinitions="*,Auto"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        RowSpacing="4">


                        <!-- NUMERO -->
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="A-025"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#101828"
                            VerticalOptions="Center"/>


                        <!-- ESTADO -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            BackgroundColor="#DDFBE5"
                            StrokeThickness="0"
                            Padding="10,4"
                            VerticalOptions="Center">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <Label
                                Text="En espera"
                                FontSize="10"
                                TextColor="#15803D"
                                FontAttributes="Bold"/>

                        </Border>


                        <!-- EMPRESA -->
                        <HorizontalStackLayout
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Spacing="7">

                            <Label
                                Text="⌂"
                                FontSize="13"
                                TextColor="#667085"/>

                            <Label
                                Text="Clínica Central"
                                FontSize="12"
                                TextColor="#475467"/>

                        </HorizontalStackLayout>


                        <!-- SERVICIO -->
                        <HorizontalStackLayout
                            Grid.Row="2"
                            Grid.Column="0"
                            Spacing="7">

                            <Label
                                Text="▤"
                                FontSize="12"
                                TextColor="#667085"/>

                            <Label
                                Text="Consulta general"
                                FontSize="12"
                                TextColor="#475467"/>

                        </HorizontalStackLayout>


                        <!-- HORA -->
                        <HorizontalStackLayout
                            Grid.Row="3"
                            Grid.Column="0"
                            Spacing="7">

                            <Label
                                Text="◷"
                                FontSize="13"
                                TextColor="#667085"/>

                            <Label
                                Text="10:30 a. m."
                                FontSize="12"
                                TextColor="#475467"/>

                        </HorizontalStackLayout>


                        <!-- FLECHA -->
                        <Label
                            Grid.Row="1"
                            Grid.RowSpan="3"
                            Grid.Column="1"
                            Text="›"
                            FontSize="28"
                            TextColor="#344054"
                            VerticalOptions="Center"
                            Margin="10,0,0,0"/>

                    </Grid>

                </Border>



                <!-- ========================= -->
                <!-- TURNO B-018 -->
                <!-- ========================= -->

                <Border
                    BackgroundColor="White"
                    Stroke="#E9EDF4"
                    StrokeThickness="1"
                    Padding="14,11">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>

                    <Grid
                        ColumnDefinitions="*,Auto"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        RowSpacing="4">

                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="B-018"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#101828"/>


                        <!-- COMPLETADO -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            BackgroundColor="#E8EDFF"
                            StrokeThickness="0"
                            Padding="10,4">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <Label
                                Text="Completado"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#4169A1"/>

                        </Border>


                        <HorizontalStackLayout
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Spacing="7">

                            <Label
                                Text="⌂"
                                FontSize="13"
                                TextColor="#667085"/>

                            <Label
                                Text="Banco Popular"
                                FontSize="12"
                                TextColor="#475467"/>

                        </HorizontalStackLayout>


                        <HorizontalStackLayout
                            Grid.Row="2"
                            Spacing="7">

                            <Label
                                Text="▤"
                                FontSize="12"
                                TextColor="#667085"/>

                            <Label
                                Text="Servicio al cliente"
                                FontSize="12"
                                TextColor="#475467"/>

                        </HorizontalStackLayout>


                        <HorizontalStackLayout
                            Grid.Row="3"
                            Spacing="7">

                            <Label
                                Text="◷"
                                FontSize="13"
                                TextColor="#667085"/>

                            <Label
                                Text="2:00 p. m."
                                FontSize="12"
                                TextColor="#475467"/>

                        </HorizontalStackLayout>

                    </Grid>

                </Border>



                <!-- ========================= -->
                <!-- TURNO C-042 -->
                <!-- ========================= -->

                <Border
                    BackgroundColor="White"
                    Stroke="#E9EDF4"
                    StrokeThickness="1"
                    Padding="14,11">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>

                    <Grid
                        ColumnDefinitions="*,Auto"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        RowSpacing="4">

                        <Label
                            Grid.Row="0"
                            Text="C-042"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#101828"/>


                        <!-- ATENDIENDO -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            BackgroundColor="#FFF0C7"
                            StrokeThickness="0"
                            Padding="10,4">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <Label
                                Text="Atendiendo"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#B46A00"/>

                        </Border>


                        <HorizontalStackLayout
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Spacing="7">

                            <Label
                                Text="⌂"
                                FontSize="13"
                                TextColor="#667085"/>

                            <Label
                                Text="Farmacia Salud"
                                FontSize="12"
                                TextColor="#475467"/>

                        </HorizontalStackLayout>


                        <HorizontalStackLayout
                            Grid.Row="2"
                            Spacing="7">

                            <Label
                                Text="▤"
                                FontSize="12"
                                TextColor="#667085"/>

                            <Label
                                Text="Retiro de medicamentos"
                                FontSize="12"
                                TextColor="#475467"/>

                        </HorizontalStackLayout>


                        <HorizontalStackLayout
                            Grid.Row="3"
                            Spacing="7">

                            <Label
                                Text="◷"
                                FontSize="13"
                                TextColor="#667085"/>

                            <Label
                                Text="11:15 a. m."
                                FontSize="12"
                                TextColor="#475467"/>

                        </HorizontalStackLayout>

                        <Label
                            Grid.Row="1"
                            Grid.RowSpan="3"
                            Grid.Column="1"
                            Text="›"
                            FontSize="28"
                            TextColor="#344054"
                            VerticalOptions="Center"
                            Margin="10,0,0,0"/>

                    </Grid>

                </Border>



                <!-- ========================= -->
                <!-- TURNO D-007 -->
                <!-- ========================= -->

                <Border
                    BackgroundColor="White"
                    Stroke="#E9EDF4"
                    StrokeThickness="1"
                    Padding="14,11">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>

                    <Grid
                        ColumnDefinitions="*,Auto"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        RowSpacing="4">

                        <Label
                            Grid.Row="0"
                            Text="D-007"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="#101828"/>


                        <!-- CANCELADO -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="1"
                            BackgroundColor="#FFE1E5"
                            StrokeThickness="0"
                            Padding="10,4">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>

                            <Label
                                Text="Cancelado"
                                FontSize="10"
                                FontAttributes="Bold"
                                TextColor="#DC3545"/>

                        </Border>


                        <HorizontalStackLayout
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Spacing="7">

                            <Label
                                Text="⌂"
                                FontSize="13"
                                TextColor="#667085"/>

                            <Label
                                Text="Supermercado Plaza"
                                FontSize="12"
                                TextColor="#475467"/>

                        </HorizontalStackLayout>


                        <HorizontalStackLayout
                            Grid.Row="2"
                            Spacing="7">

                            <Label
                                Text="▤"
                                FontSize="12"
                                TextColor="#667085"/>

                            <Label
                                Text="Atención en caja"
                                FontSize="12"
                                TextColor="#475467"/>

                        </HorizontalStackLayout>


                        <HorizontalStackLayout
                            Grid.Row="3"
                            Spacing="7">

                            <Label
                                Text="◷"
                                FontSize="13"
                                TextColor="#667085"/>

                            <Label
                                Text="9:00 a. m."
                                FontSize="12"
                                TextColor="#475467"/>

                        </HorizontalStackLayout>

                    </Grid>

                </Border>

            </VerticalStackLayout>

        </ScrollView>



        <!-- ========================= -->
        <!-- BOTÓN NUEVO TURNO -->
        <!-- ========================= -->

        <Button
            Grid.Row="2"
            Text="+   Nuevo turno"
            HeightRequest="48"
            Margin="20,5,20,5"
            CornerRadius="10"
            BackgroundColor="#087BF5"
            TextColor="White"
            FontSize="14"
            FontAttributes="Bold"
            Clicked="OnNuevoTurnoClicked"/>



        <!-- ========================= -->
        <!-- BARRA INFERIOR -->
        <!-- ========================= -->

        <Border
            Grid.Row="3"
            BackgroundColor="White"
            Stroke="#E5E7EB"
            StrokeThickness="1"
            Padding="20,7">

            <Grid ColumnDefinitions="*,*,*">


                <!-- INICIO -->
                <VerticalStackLayout
                    Grid.Column="0"
                    HorizontalOptions="Center"
                    Spacing="2">

                    <Label
                        Text="⌂"
                        FontSize="19"
                        TextColor="#667085"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="Inicio"
                        FontSize="10"
                        TextColor="#667085"/>

                </VerticalStackLayout>


                <!-- TURNOS ACTIVO -->
                <VerticalStackLayout
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    Spacing="2">

                    <Label
                        Text="◷"
                        FontSize="19"
                        TextColor="#087BF5"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="Turnos"
                        FontSize="10"
                        FontAttributes="Bold"
                        TextColor="#087BF5"/>

                </VerticalStackLayout>


                <!-- PERFIL -->
                <VerticalStackLayout
                    Grid.Column="2"
                    HorizontalOptions="Center"
                    Spacing="2">

                    <Label
                        Text="♙"
                        FontSize="19"
                        TextColor="#667085"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        Text="Perfil"
                        FontSize="10"
                        TextColor="#667085"/>

                </VerticalStackLayout>

            </Grid>

        </Border>

    </Grid>

</ContentPage>